{
  "$schema": "./node_modules/@angular/service-worker/config/schema.json",
  "index": "/index.html",
  "assetGroups": [
    {
      "name": "app",
      "installMode": "prefetch",
      "resources": {
        "files": [
          "/favicon.ico",
          "/index.csr.html",
          "/manifest.webmanifest",
          "/*.css",
          "/*.js",
          "/icons/icon.svg",
          "/media/inter-latin-wght-normal-*.woff2",
          "/media/jetbrains-mono-latin-wght-normal-*.woff2",
          "/media/source-serif-4-latin-wght-normal-*.woff2",
          "/media/material-symbols-outlined-*.woff2"
        ]
      }
    },
    {
      "name": "assets",
      "installMode": "lazy",
      "updateMode": "prefetch",
      "resources": {
        "files": ["/icons/**", "/media/**"]
      }
    }
  ]
}
