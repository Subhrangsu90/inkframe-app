{
  "name": "inkframe-app",
  "version": "0.7.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "build:app": "ng build inkframe-app",
    "build:app:prod": "ng build inkframe-app --configuration production && node scripts/add-csp.mjs",
    "build:app:staging": "ng build inkframe-app --configuration production,staging && node scripts/add-csp.mjs",
    "build:lib": "ng build inkframe-editor",
    "build:lib:prod": "ng build inkframe-editor --configuration production",
    "build:all": "npm run build:lib && npm run build:app",
    "watch": "ng build --watch --configuration development",
    "watch:lib": "ng build inkframe-editor --watch --configuration development",
    "test": "npm run test:lib && npm run test:app",
    "test:watch": "ng test inkframe-editor",
    "test:lib": "ng test inkframe-editor --watch=false",
    "test:app": "ng test inkframe-app --watch=false",
    "link:lib": "npm run build:lib && cd dist/inkframe-editor && npm link",
    "unlink:lib": "npm unlink -g @inkframe-ui/editor",
    "pack:lib": "npm run build:lib && npm pack ./dist/inkframe-editor",
    "publish:lib": "npm run build:lib && npm publish ./dist/inkframe-editor --access public",
    "publish:lib:dry": "npm run build:lib && npm publish ./dist/inkframe-editor --dry-run",
    "format": "prettier --write \"projects/**/*.{ts,scss,html,json}\" \"src/**/*.{ts,scss,html,json}\"",
    "format:check": "prettier --check \"projects/**/*.{ts,scss,html,json}\" \"src/**/*.{ts,scss,html,json}\"",
    "serve:ssr:inkframe-app": "node dist/inkframe-app/server/server.mjs",
    "icons:build": "node scripts/build-icon-font.mjs",
    "icons:check": "node scripts/build-icon-font.mjs --check",
    "lint": "ng lint"
  },
  "private": true,
  "packageManager": "npm@11.6.4",
  "dependencies": {
    "@angular/cdk": "^22.2.1",
    "@angular/common": "^22.1.0",
    "@angular/compiler": "^22.1.0",
    "@angular/core": "^22.1.0",
    "@angular/forms": "^22.1.0",
    "@angular/material": "^22.2.1",
    "@angular/platform-browser": "^22.1.0",
    "@angular/platform-server": "^22.1.0",
    "@angular/router": "^22.1.0",
    "@angular/service-worker": "^22.2.1",
    "@angular/ssr": "^22.1.6",
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@fontsource-variable/source-serif-4": "5.3.0",
    "better-auth": "^1.7.11",
    "dompurify": "^3.4.17",
    "express": "^5.1.0",
    "markdown-it": "^14.3.3",
    "prismjs": "^1.30.0",
    "prosemirror-commands": "^1.7.2",
    "prosemirror-dropcursor": "^1.8.4",
    "prosemirror-gapcursor": "^1.4.1",
    "prosemirror-history": "^1.5.1",
    "prosemirror-inputrules": "^1.5.1",
    "prosemirror-keymap": "^1.2.3",
    "prosemirror-markdown": "^1.13.8",
    "prosemirror-model": "^1.25.12",
    "prosemirror-schema-basic": "^1.2.5",
    "prosemirror-schema-list": "^1.5.1",
    "prosemirror-state": "^1.4.4",
    "prosemirror-tables": "^1.8.5",
    "prosemirror-transform": "^1.12.2",
    "prosemirror-view": "^1.42.6",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@angular/build": "^22.1.6",
    "@angular/cli": "^22.1.6",
    "@angular/compiler-cli": "^22.1.0",
    "@eslint/js": "^10.0.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/express": "^5.0.1",
    "@types/markdown-it": "^14.2.0",
    "@types/node": "^26.6.5",
    "@types/prismjs": "^1.26.6",
    "angular-eslint": "22.6.0",
    "eslint": "^10.12.0",
    "fake-indexeddb": "^6.2.6",
    "jsdom": "^28.0.0",
    "ng-packagr": "^22.2.0",
    "postcss": "^8.5.29",
    "prettier": "^3.8.1",
    "prosemirror-test-builder": "^1.1.1",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "typescript-eslint": "8.71.0",
    "vitest": "^4.0.8"
  },
  "overrides": {
    "vite": "8.3.5"
  }
}
