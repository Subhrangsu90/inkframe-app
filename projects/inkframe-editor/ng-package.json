{
  "$schema": "../../node_modules/ng-packagr/ng-package.schema.json",
  "dest": "../../dist/inkframe-editor",
  "lib": {
    "entryFile": "src/public-api.ts"
  },
  "assets": [
    {
      "glob": "**/*",
      "input": "src/styles",
      "output": "styles"
    }
  ],
  "allowedNonPeerDependencies": [
    "dompurify",
    "markdown-it",
    "prismjs",
    "prosemirror-.*",
    "rxjs",
    "tslib"
  ]
}
