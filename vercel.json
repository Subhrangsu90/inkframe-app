{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build:app:staging",
  "routes": [
    {
      "src": "^/(api/auth|v1)/(.*)$",
      "dest": "https://inkframe-server.onrender.com/$1/$2",
      "transforms": [
        {
          "type": "request.headers",
          "op": "set",
          "target": { "key": "x-origin-secret" },
          "args": "$ORIGIN_SECRET",
          "env": ["ORIGIN_SECRET"]
        }
      ]
    }
  ]
}
